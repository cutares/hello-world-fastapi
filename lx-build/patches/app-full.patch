diff --git a/src/plugins/player/systemMedia.ts b/src/plugins/player/systemMedia.ts
new file mode 100644
index 0000000..1b049f5
--- /dev/null
+++ b/src/plugins/player/systemMedia.ts
@@ -0,0 +1,130 @@
+import { DeviceEventEmitter, NativeModules, Platform } from 'react-native'
+import playerState from '@/store/player/state'
+import settingState from '@/store/setting/state'
+import { updateSetting } from '@/core/common'
+import { LIST_IDS } from '@/config/constant'
+import { getListMusics } from '@/utils/listManage'
+import { addListMusics, removeListMusics } from '@/core/list'
+import { getCurrentSystemMediaId, syncSystemQueue, getSystemMediaGeneration } from './systemQueue'
+
+let initialized = false
+let context = playerState.playMusicInfo
+let generation = getSystemMediaGeneration()
+let stopped = false
+const synced = { clearedGeneration: -1, lastLyrics: '', lastMode: -1 }
+let pending = Promise.resolve()
+
+// The system protocol has no honest equivalent for sequential or stop-after-one.
+export const getSystemRepeatMode = () => {
+  switch (settingState.setting['player.togglePlayMethod']) {
+    case 'listLoop': return 1
+    case 'singleLoop': return 2
+    case 'random': return 3
+    default: return 0
+  }
+}
+
+export const changeSystemPlayMode = () => {
+  const mode = settingState.setting['player.togglePlayMethod']
+  updateSetting({ 'player.togglePlayMethod': mode === 'listLoop' ? 'singleLoop' : mode === 'singleLoop' ? 'random' : 'listLoop' })
+}
+
+const updateContext = () => {
+  generation = getSystemMediaGeneration()
+  if (context === playerState.playMusicInfo) return
+  context = playerState.playMusicInfo
+  stopped = false
+  synced.lastLyrics = ''
+}
+
+export const syncSystemMedia = async(force = false) => {
+  updateContext()
+  if (Platform.OS !== 'android' || !global.lx.playerStatus.isInitialized) return
+  pending = pending.then(async() => {
+    if (force) {
+      synced.clearedGeneration = -1
+      synced.lastLyrics = ''
+      synced.lastMode = -1
+    }
+    if (!global.lx.playerStatus.isInitialized) return
+    const bridge = NativeModules.TrackPlayerModule
+    const mode = getSystemRepeatMode()
+    if (typeof bridge?.setSystemRepeatMode === 'function' && mode !== synced.lastMode) {
+      if (await bridge.setSystemRepeatMode(mode) !== false) synced.lastMode = mode
+    }
+    if (typeof bridge?.setSystemLyrics !== 'function') return
+    const currentGeneration = generation
+    const currentContext = context
+    await syncSystemQueue()
+    if (currentGeneration !== generation || currentContext !== playerState.playMusicInfo) return
+    const mediaId = getCurrentSystemMediaId()
+    // Clear first even when returning to the same song (A -> B -> A).
+    if (synced.clearedGeneration !== currentGeneration) {
+      if (await bridge.setSystemLyrics(mediaId, currentGeneration, '') === false) return
+      if (currentGeneration !== generation) return
+      synced.clearedGeneration = currentGeneration
+      synced.lastLyrics = ''
+    }
+    const info = playerState.musicInfo
+    const raw = !stopped && context.musicInfo?.id === info.id ? info.lrc : null
+    // Reject oversize data as a whole; never cut a timed LRC in the middle.
+    const lyric = typeof raw === 'string' && raw.length <= 65_536 ? raw : ''
+    const payload = JSON.stringify([mediaId, currentGeneration, lyric])
+    if (payload !== synced.lastLyrics) {
+      if (await bridge.setSystemLyrics(mediaId, currentGeneration, lyric) === false) return
+      if (currentGeneration === generation) synced.lastLyrics = payload
+    }
+    if (typeof bridge.setSystemFavorite === 'function' && mediaId && currentContext.musicInfo) {
+      const music = 'progress' in currentContext.musicInfo ? currentContext.musicInfo.metadata.musicInfo : currentContext.musicInfo
+      const favorites = await getListMusics(LIST_IDS.LOVE)
+      if (currentGeneration !== generation || currentContext !== playerState.playMusicInfo) return
+      await bridge.setSystemFavorite(mediaId, currentGeneration, favorites.some(item => item.id === music.id))
+    }
+  }).catch(() => { console.warn('System media sync failed') })
+  return pending
+}
+
+let favoriteUpdates = Promise.resolve()
+export const changeSystemFavorite = async(event: unknown) => {
+  if (!event || typeof event !== 'object') return
+  const { id, generation: requestedGeneration, favorite } = event as { id?: unknown, generation?: unknown, favorite?: unknown }
+  if (typeof id !== 'string' || typeof requestedGeneration !== 'number' || typeof favorite !== 'boolean') return
+  const selectedContext = playerState.playMusicInfo
+  favoriteUpdates = favoriteUpdates.then(async() => {
+    updateContext()
+    if (id !== getCurrentSystemMediaId() || requestedGeneration !== generation || selectedContext !== playerState.playMusicInfo) return
+    const selected = selectedContext.musicInfo
+    if (!selected) return
+    const music = 'progress' in selected ? selected.metadata.musicInfo : selected
+    // Apply the requested state to My Favorites only, never toggle another list.
+    if (favorite) await addListMusics(LIST_IDS.LOVE, [music], settingState.setting['list.addMusicLocationType'])
+    else await removeListMusics(LIST_IDS.LOVE, [music.id])
+    await syncSystemMedia()
+  }).catch(() => { console.warn('System favorite update failed'); void syncSystemMedia() })
+  return favoriteUpdates
+}
+
+export const initializeSystemMedia = () => {
+  if (initialized) return
+  initialized = true
+  const sync = () => { void syncSystemMedia() }
+  const clear = () => {
+    // Stop/error may resume the same engine item; preserve its identity generation.
+    stopped = true
+    sync()
+  }
+  global.state_event.on('playMusicInfoChanged', sync)
+  global.state_event.on('playerMusicInfoChanged', sync)
+  global.state_event.on('playInfoChanged', sync)
+  global.state_event.on('playTempPlayListChanged', sync)
+  global.app_event.on('myListMusicUpdate', sync)
+  global.app_event.on('lyricUpdated', sync)
+  global.app_event.on('stop', clear)
+  global.app_event.on('error', clear)
+  global.app_event.on('play', () => { stopped = false; sync() })
+  global.state_event.on('configUpdated', (keys) => {
+    if (keys.includes('player.togglePlayMethod')) sync()
+  })
+  DeviceEventEmitter.addListener('remote-play-mode-change', changeSystemPlayMode)
+  DeviceEventEmitter.addListener('remote-favorite-change', (event: unknown) => { void changeSystemFavorite(event) })
+}
diff --git a/src/plugins/player/systemQueue.ts b/src/plugins/player/systemQueue.ts
new file mode 100644
index 0000000..fe56b84
--- /dev/null
+++ b/src/plugins/player/systemQueue.ts
@@ -0,0 +1,106 @@
+import { NativeModules, Platform } from 'react-native'
+import playerState from '@/store/player/state'
+import { getList } from '@/core/player/playInfo'
+
+interface Selection { kind: 'list' | 'temp' | 'current', listId: string | null, musicInfo: LX.Player.PlayMusic }
+interface QueueEntry { id: string, title: string, artist: string, album: string }
+const limit = 200
+let selections = new Map<string, Selection>()
+let initialized = false
+let scheduled = false
+let lastPayload = ''
+let currentSystemMediaId = ''
+let publishedContext: typeof playerState.playMusicInfo | null = null
+let publishedGeneration = -1
+let mediaContext = playerState.playMusicInfo
+let mediaGeneration = Date.now()
+export const getSystemMediaGeneration = () => {
+  if (mediaContext !== playerState.playMusicInfo) {
+    mediaContext = playerState.playMusicInfo
+    mediaGeneration++
+  }
+  return mediaGeneration
+}
+export const getCurrentSystemMediaId = () => publishedContext === playerState.playMusicInfo && publishedGeneration === getSystemMediaGeneration() ? currentSystemMediaId : ''
+let updating = Promise.resolve()
+const makeId = (entry: Selection) => JSON.stringify([entry.kind, entry.listId, entry.musicInfo.id])
+
+// Do not resolve stream URLs or change the playback queue for display metadata.
+const buildQueue = () => {
+  const current = playerState.playMusicInfo
+  const mainListId = playerState.playInfo.playerListId
+  const source = getList(mainListId)
+  const currentIndex = source.findIndex(music => music.id === current.musicInfo?.id)
+  const start = Math.max(0, currentIndex - Math.floor(limit / 2))
+  const entries: Selection[] = []
+  if (current.musicInfo && (current.isTempPlay || currentIndex < 0)) {
+    entries.push({ kind: 'current', listId: current.listId, musicInfo: current.musicInfo })
+  }
+  // Reserve some room for explicitly queued "play later" entries.
+  const tempLimit = Math.min(playerState.tempPlayList.length, 50)
+  for (const item of source.slice(start, start + limit - tempLimit - entries.length)) {
+    entries.push({ kind: 'list', listId: mainListId, musicInfo: item })
+  }
+  for (const item of playerState.tempPlayList.slice(0, tempLimit)) {
+    entries.push({ kind: 'temp', listId: item.listId, musicInfo: item.musicInfo })
+  }
+  const nextSelections = new Map<string, Selection>()
+  const tracks: QueueEntry[] = []
+  let activeId = ''
+  for (const entry of entries) {
+    const id = makeId(entry)
+    if (nextSelections.has(id) || id.length > 512) continue
+    nextSelections.set(id, entry)
+    const music = 'progress' in entry.musicInfo ? entry.musicInfo.metadata.musicInfo : entry.musicInfo
+    tracks.push({ id, title: music.name.slice(0, 128), artist: music.singer.slice(0, 128), album: (music.meta.albumName ?? '').slice(0, 128) })
+    if (entry.kind !== 'temp' && entry.musicInfo.id === current.musicInfo?.id && entry.listId === current.listId) activeId = id
+  }
+  return { nextSelections, tracks, activeId }
+}
+
+export const getSystemQueueSelection = (id: unknown): Selection | undefined => typeof id === 'string' ? selections.get(id) : undefined
+
+export const syncSystemQueue = async(force = false) => {
+  if (Platform.OS !== 'android' || !global.lx.playerStatus.isInitialized || typeof NativeModules.TrackPlayerModule?.setSystemQueue !== 'function') return
+  // Serialise native writes; always build from the latest JS state at execution time.
+  updating = updating.then(async() => {
+    const { nextSelections, tracks, activeId } = buildQueue()
+    selections = nextSelections
+    const generation = getSystemMediaGeneration()
+    const context = playerState.playMusicInfo
+    const payload = JSON.stringify([tracks, activeId, generation])
+    if (!force && payload === lastPayload) return
+    if (typeof NativeModules.TrackPlayerModule.setSystemQueueContext === 'function') {
+      if (await NativeModules.TrackPlayerModule.setSystemQueueContext(tracks, activeId, generation) === false) return
+    } else await NativeModules.TrackPlayerModule.setSystemQueue(tracks, activeId)
+    // Native writes and this cache update are serialised by the updating promise chain.
+    // eslint-disable-next-line require-atomic-updates
+    lastPayload = payload
+    currentSystemMediaId = activeId
+    publishedContext = context
+    publishedGeneration = generation
+  }).catch(() => {
+    console.warn('System queue sync failed')
+  })
+  return updating
+}
+
+export const initializeSystemQueue = () => {
+  if (initialized) return
+  initialized = true
+  const schedule = () => {
+    if (scheduled) return
+    scheduled = true
+    setTimeout(() => {
+      scheduled = false
+      void syncSystemQueue()
+    }, 0)
+  }
+  global.app_event.on('musicToggled', schedule)
+  global.app_event.on('myListMusicUpdate', schedule)
+  global.app_event.on('downloadListUpdate', schedule)
+  global.state_event.on('playInfoChanged', schedule)
+  global.state_event.on('playTempPlayListChanged', schedule)
+  global.state_event.on('playMusicInfoChanged', schedule)
+  schedule()
+}
