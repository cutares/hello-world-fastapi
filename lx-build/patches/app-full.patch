@@ -0,0 +1,32 @@
+import { memo } from 'react'
+import { View, StyleSheet } from 'react-native'
+import { scaleSizeW } from '@/utils/pixelRatio'
+import vinyl from '@/resources/branding/vinyl.json'
+
+// Native geometry, not a font glyph: crisp at both menu sizes and no new dependency.
+const styles = StyleSheet.create({
+  frame: { alignItems: 'center', justifyContent: 'center', flexShrink: 0 },
+  art: { width: 100, height: 100, flexShrink: 0 },
+  disc: { position: 'absolute', left: 2, top: 2, width: 96, height: 96, borderRadius: 48, backgroundColor: vinyl.disc, borderWidth: 1, borderColor: vinyl.cream },
+  // Show only the upper-right quarter of the ring, then add rounded endpoints.
+  clip: { position: 'absolute', left: 50, top: 0, width: 50, height: 50, overflow: 'hidden' },
+  ring: { position: 'absolute', left: -37, top: 13, width: 74, height: 74, borderRadius: 37, borderWidth: 6, borderColor: vinyl.orange },
+  start: { position: 'absolute', left: 47, top: 13, width: 6, height: 6, borderRadius: 3, backgroundColor: vinyl.orange },
+  end: { position: 'absolute', left: 81, top: 47, width: 6, height: 6, borderRadius: 3, backgroundColor: vinyl.orange },
+  hole: { position: 'absolute', left: 41, top: 41, width: 18, height: 18, borderRadius: 9, backgroundColor: vinyl.cream },
+})
+
+export default memo(({ size = 28 }: { size?: number }) => {
+  const width = scaleSizeW(size)
+  return (
+    <View accessible={false} importantForAccessibility="no-hide-descendants" pointerEvents="none" style={[styles.frame, { width, height: width }]}>
+      <View style={[styles.art, { transform: [{ scale: width / 100 }] }]}>
+        <View style={styles.disc} />
+        <View style={styles.clip}><View style={styles.ring} /></View>
+        <View style={styles.start} />
+        <View style={styles.end} />
+        <View style={styles.hole} />
+      </View>
+    </View>
+  )
+})
