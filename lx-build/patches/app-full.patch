diff --git a/scripts/generate-branding.py b/scripts/generate-branding.py
new file mode 100644
index 0000000..7a2f2d3
--- /dev/null
+++ b/scripts/generate-branding.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""Reproducible B-vinyl launcher assets, Python standard library only.
+No concept artwork is cropped or embedded. Geometry matches MusicLogo.tsx.
+"""
+import argparse
+import json
+import math
+import struct
+import zlib
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = json.loads((ROOT / 'src/resources/branding/vinyl.json').read_text())
+RES = ROOT / 'android/app/src/main/res'
+DENSITIES = {'mdpi': 48, 'hdpi': 72, 'xhdpi': 96, 'xxhdpi': 144, 'xxxhdpi': 192}
+
+
+def rgba(hex_color):
+    return tuple(int(hex_color[i:i + 2], 16) for i in (1, 3, 5)) + (255,)
+
+
+def pixel(x, y, circular):
+    # Legacy canvas 100x100; no shadow. Adaptive uses a separate 108dp vector.
+    if circular:
+        inside = math.hypot(x - 50, y - 50) <= 50
+    else:
+        inside = math.hypot(max(abs(x - 50) - 28, 0), max(abs(y - 50) - 28, 0)) <= 22
+    if not inside:
+        return (0, 0, 0, 0)
+    color = rgba(SPEC['cream'])
+    # Scale the native 100-unit mark to a 75-unit glyph centered on the canvas.
+    x, y = (x - 50) / .75, (y - 50) / .75
+    if math.hypot(x, y) <= SPEC['discRadius']:
+        color = rgba(SPEC['disc'])
+    radius, half = SPEC['arcRadius'], SPEC['arcWidth'] / 2
+    arc = x >= 0 and y <= 0 and abs(math.hypot(x, y) - radius) <= half
+    caps = math.hypot(x, y + radius) <= half or math.hypot(x - radius, y) <= half
+    if arc or caps:
+        color = rgba(SPEC['orange'])
+    if math.hypot(x, y) <= SPEC['holeRadius']:
+        color = rgba(SPEC['cream'])
+    return color
+
+
+def png(size, circular):
+    # 4x supersampling with premultiplied-alpha averaging for clean transparent edges.
+    rows = []
+    for iy in range(size):
+        row = bytearray([0])
+        for ix in range(size):
+            samples = [pixel((ix + (sx + .5) / 4) * 100 / size,
+                             (iy + (sy + .5) / 4) * 100 / size, circular)
+                       for sy in range(4) for sx in range(4)]
+            alpha = sum(p[3] for p in samples)
+            row.extend([round(sum(p[c] * p[3] for p in samples) / alpha) if alpha else 0 for c in range(3)])
+            row.append(round(alpha / 16))
+        rows.append(bytes(row))
+    def chunk(kind, data):
+        return struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data) & 0xffffffff)
+    return b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', size, size, 8, 6, 0, 0, 0)) + chunk(b'IDAT', zlib.compress(b''.join(rows), 9)) + chunk(b'IEND', b'')
+
+
+def assets():
+    result = {}
+    for density, size in DENSITIES.items():
+        for suffix in ('', '_round'):
+            result[RES / f'mipmap-{density}/ic_launcher{suffix}.png'] = png(size, bool(suffix))
+    # Radius 32 fits fully inside the 66dp guaranteed-safe zone of a 108dp layer.
+    result[RES / 'drawable/ic_launcher_foreground.xml'] = f'''<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp" android:height="108dp"
+    android:viewportWidth="108" android:viewportHeight="108">
+  <group android:scaleX="0.6666667" android:scaleY="0.6666667"
+      android:translateX="20.666665" android:translateY="20.666665">
+    <path android:fillColor="{SPEC['disc']}" android:pathData="M50,2 A48,48 0,1 1,50,98 A48,48 0,1 1,50,2"/>
+    <path android:fillColor="@android:color/transparent" android:strokeColor="{SPEC['orange']}"
+        android:strokeWidth="6" android:strokeLineCap="round" android:pathData="M50,16 A34,34 0,0 1,84,50"/>
+    <path android:fillColor="{SPEC['cream']}" android:pathData="M50,41 A9,9 0,1 1,50,59 A9,9 0,1 1,50,41"/>
+  </group>
+</vector>
+'''.encode()
+    result[RES / 'values/ic_launcher_background.xml'] = f'''<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <color name="ic_launcher_background">{SPEC['cream']}</color>
+</resources>
+'''.encode()
+    return result
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--check', action='store_true', help='Verify committed assets without writing')
+    args = parser.parse_args()
+    for file, content in assets().items():
+        if args.check:
+            assert file.read_bytes() == content, f'Generated asset differs: {file}'
+        else:
+            file.write_bytes(content)
+    print('PASS: deterministic vinyl assets' if args.check else 'Generated vinyl launcher assets')
