+/** Select display-queue metadata through LX's URL resolution, never a native queue index. */
+export const playSystemQueueItem = async(id: unknown) => {
+  const selected = getSystemQueueSelection(id)
+  if (!selected) return
+  if (selected.kind === 'current') {
+    if (playerState.playMusicInfo.musicInfo?.id === selected.musicInfo.id && playerState.playMusicInfo.listId === selected.listId) play()
+    return
+  }
+  if (selected.kind === 'temp') {
+    const index = playerState.tempPlayList.findIndex(item => item.listId === selected.listId && item.musicInfo.id === selected.musicInfo.id)
+    if (index < 0) { void syncSystemQueue(); return }
+    const item = playerState.tempPlayList[index]
+    removeTempPlayList(index)
+    setPlayMusicInfo(item.listId, item.musicInfo, true)
+  } else {
+    if (selected.listId !== playerState.playInfo.playerListId) return
+    const musicInfo = getList(selected.listId).find(item => item.id === selected.musicInfo.id)
+    if (!musicInfo) { void syncSystemQueue(); return }
+    setPlayMusicInfo(selected.listId, musicInfo, false)
+    if (settingState.setting['player.isAutoCleanPlayedList']) clearPlayedList()
+  }
+  await handlePlay()
+}
